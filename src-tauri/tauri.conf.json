{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Grsai Image and Video Generator",
  "version": "0.1.0",
  "identifier": "com.grsaibanana.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Grsai Image and Video Generator",
        "url": "index.html",
        "width": 1100,
        "height": 750,
        "minWidth": 1060,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
